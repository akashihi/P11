# Copy this file to secrets.yaml and fill in your own values.
# secrets.yaml is ignored by git - never commit it.

wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# Password for the fallback hotspot that starts when Wi-Fi is unreachable
fallback_ap_password: "change-me-please"

# Password required for over-the-air firmware updates
ota_password: "change-me-too"

# Home Assistant API encryption key (32 bytes, base64)
# Generate with: openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_OUTPUT_OF_openssl_rand_-base64_32"
